{
	"name": "obsidian-leaflet-bases-plugin",
	"version": "1.3.0",
	"description": "Interactive map view inside your bases. Forked from Requiae/obsidian-leaflet-bases-plugin.",
	"main": "main.js",
	"type": "module",
	"author": "Arno Esterhuizen",
	"contributors": [
		{
			"name": "Sara Lilith Slootmaker",
			"url": "https://github.com/Requiae"
		}
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/arnoe/obsidian-leaflet-bases-plugin"
	},
	"scripts": {
		"dev": "node build-styles.mjs && node esbuild.config.mjs",
		"build": "node build-styles.mjs && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"build:styles": "node build-styles.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"test": "vitest"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@emnapi/core": "1.11.3",
		"@emnapi/runtime": "1.11.3",
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@types/leaflet": "^1.9.22",
		"@types/node": "26.2.0",
		"esbuild": "0.28.2",
		"eslint": "^10.8.1",
		"eslint-plugin-obsidianmd": "0.4.1",
		"globals": "^17.11.0",
		"jiti": "2.7.0",
		"obsidian": "^1.14.4",
		"obsidian-typings": "^6.59.0",
		"ts-node": "^10.9.2",
		"tslib": "2.8.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10",
		"yaml": "^2.9.0"
	},
	"dependencies": {
		"leaflet": "^1.9.4"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
